# ── LLM (dynamic generation) ──────────────────────────────────────
GROQ_API_KEY=

# ── Database ────────────────────────────────────────────────────────
# Local dev: any Postgres URL, or leave empty to fall back to SQLite (see
# db.py). Production (Vercel serverless): use Supabase's *pooled* connection
# string (Project Settings → Database → Connection pooling, "Transaction"
# mode, port 6543) instead of the direct one (port 5432) — each serverless
# invocation opens its own connection, and the direct connection limit on
# the free tier is exhausted fast without PgBouncer in front of it. db.py
# auto-detects the pooler port and disables psycopg's server-side prepared
# statements accordingly (required for PgBouncer transaction mode).
DATABASE_URL=postgresql://user:password@localhost:5432/retro_dynamics

# ── Realtime (live board) ─────────────────────────────────────────
LIVEBLOCKS_SECRET_KEY=

# ── CORS ──────────────────────────────────────────────────────────
# Only needed in a real deployment: the deployed frontend's URL (comma-
# separated if more than one), added on top of the always-allowed local
# Vite origins (http://localhost:5173 / 127.0.0.1:5173). Leave empty for
# local dev.
FRONTEND_ORIGIN=

# ── Jira ──────────────────────────────────────────────────────────
JIRA_DOMAIN=
JIRA_EMAIL=
JIRA_API_TOKEN=

# ── Azure DevOps ──────────────────────────────────────────────────
AZURE_DEVOPS_ORG_URL=
AZURE_DEVOPS_PAT=
